# WebHunt Android Release Signing Configuration Example
# Copy this file to 'keystore.properties' and fill in your actual production release keystore values.
# NEVER commit 'keystore.properties' or your .jks/.keystore file into Git!

storeFile=C:/path/to/webhunt-release-key.jks
storePassword=YourKeystorePasswordHere
keyAlias=webhunt_key
keyPassword=YourKeyPasswordHere
